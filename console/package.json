{
  "name": "fleet-console",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.app.json --noEmit",
    "migrate": "node scripts/migrate.mjs",
    "bootstrap": "node scripts/bootstrap-operator.mjs",
    "build:test": "tsc -p tsconfig.test.json",
    "test": "bash scripts/with-test-db.sh \"npm run build:test && node --test test/*.test.mjs\""
  },
  "dependencies": {
    "pg": "^8.13.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vercel/node": "^5.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
