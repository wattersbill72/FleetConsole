# Postgres (Neon pooled connection string in production)
DATABASE_URL=postgres://user:pass@localhost:5432/fleetconsole
# Required. 32+ random bytes, e.g. `openssl rand -hex 32`
SESSION_SECRET=
# Optional
SESSION_IDLE_MINUTES=480
# Public address of this console, used in install commands. Set it in production.
CONSOLE_URL=https://fleet.example.com
# Agent downloads: a GitHub token that can read releases of this repo (fine-grained, Contents: read)
GITHUB_REPO=owner/repo
GITHUB_RELEASE_TOKEN=
# Required for the per-minute stale-detection cron. Vercel sends it as "Authorization: Bearer <value>".
CRON_SECRET=
