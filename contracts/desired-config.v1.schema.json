{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "desired-config.v1",
  "title": "Desired Config v1",
  "description": "Versioned configuration the console wants a node to run. Invalid config is rejected by the agent, which keeps the last good version and reports the reason.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "version", "heartbeat_interval_s"],
  "properties": {
    "schema_version": { "const": 1 },
    "version": { "type": "integer", "minimum": 1 },
    "heartbeat_interval_s": { "type": "integer", "minimum": 30, "maximum": 300, "default": 60 },
    "intermittent": { "type": "boolean", "default": false },
    "watched_services": {
      "type": "array", "maxItems": 200,
      "items": { "type": "object", "additionalProperties": false, "required": ["name", "kind"],
        "properties": { "name": { "type": "string", "maxLength": 255 }, "kind": { "enum": ["os-service", "container"] } } }
    },
    "disk_volumes": { "type": "array", "maxItems": 32, "items": { "type": "string", "maxLength": 255 } },
    "sovereignai": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "sis_address": { "type": "string", "maxLength": 255 },
        "sisc_address": { "type": "string", "maxLength": 255 }
      }
    },
    "log_shipping": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "sources": { "type": "array", "maxItems": 64, "items": { "type": "string", "maxLength": 255 } }
      }
    },
    "redaction_patterns": { "type": "array", "maxItems": 50, "items": { "type": "string", "maxLength": 500, "description": "Regex, added to built-in defaults (bearer tokens, API keys, connection-string passwords, emails)." } },
    "alert_thresholds": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "disk_pct": { "type": "number", "minimum": 1, "maximum": 100, "default": 85 },
        "service_down_intervals": { "type": "integer", "minimum": 1, "default": 2 }
      }
    }
  }
}
